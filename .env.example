PORT=3000
# Required dashboard password. Set privately in Render; never commit its value.
SECRET_MDP=
# Optional, separate restrictions for game reporters and legacy viewer tokens.
SAE_REPORT_TOKEN=
SAE_VIEW_TOKEN=
# Configure privately on Render for durable history. Never commit a real URI/password.
MONGODB_URI=
MONGODB_DB=autosae
# Disk fallback only when MONGODB_URI is absent.
# SAE_DATA_DIR=/var/data


# Single Roblox account managed through SEA_V2 Admin.lua.
ADMIN_USERNAME=MagixSafe
